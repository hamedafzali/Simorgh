{
  "general": {
    "appName": "Simorgh",
    "version": "1.0.0",
    "maxUsers": 10000,
    "maintenance": false,
    "debugMode": false
  },
  "database": {
    "host": "localhost",
    "port": 27017,
    "name": "simorgh",
    "autoBackup": true,
    "backupInterval": 24,
    "maxBackups": 10
